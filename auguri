        /* Flame Effect */
        .flame {
            width: 16px;
            height: 26px;
            background: linear-gradient(#ffff80, #ff9900, #ff3300);
            border-radius: 50% 50% 20% 20%;
            position: absolute;
            top: -24px;
            left: calc(50% - 8px);
            animation: flicker 0.6s infinite alternate;
            box-shadow: 0 0 15px #ffaa00, 0 0 25px #ffffaa;
