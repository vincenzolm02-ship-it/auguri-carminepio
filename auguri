    <script>
        // Trigger initial celebration confetti on page load
        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                triggerConfetti();
            }, 600);
        });

        // Confetti Generator
        function triggerConfetti() {
            playPopSound();
            confetti({
                particleCount: 80,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#e5b842', '#ffffff', '#0080FF', '#ffd700']
            });
        }

        // Blow out candle interaction
        function blowCandle() {
            const flame = document.getElementById('flame');
            const smoke = document.getElementById('smoke');
            const hint = document.getElementById('candle-hint');

            if (!flame.classList.contains('extinguished')) {
                flame.classList.add('extinguished');
                smoke.style.display = 'block';
                hint.innerText = "✨ Candelina spenta! Desiderio espresso con successo!";
                hint.className = "text-xs text-emerald-400 font-bold animate-pulse";
                triggerConfetti();
            }
        }

        // Gift Unboxing & Ticket Reveal Animation
        function revealTicket() {
            triggerConfetti();
            toggleAudio(); // Start ambient stadium background audio

            const giftBox = document.getElementById('gift-box-section');
            const ticketSection = document.getElementById('ticket-section');

            giftBox.style.display = 'none';
            ticketSection.classList.remove('hidden');

            setTimeout(() => {
                ticketSection.classList.remove('scale-95', 'opacity-0');
                ticketSection.classList.add('scale-100', 'opacity-100');
                ticketSection.scrollIntoView({ behavior: 'smooth' });
            }, 50);
        }
